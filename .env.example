# ── App ────────────────────────────────────────────────
NEXT_PUBLIC_APP_NAME=fod-track

# ── Vision provider (pick ONE; Ollama wins if both set) ──
# Option A: Ollama — free, local, no key. Install: https://ollama.com
#   ollama pull qwen2.5vl:7b        (recommended; llama3.2-vision:11b also works)
OLLAMA_BASE_URL=
#   e.g. http://127.0.0.1:11434  (or a LAN GPU box: http://192.168.1.50:11434)
OLLAMA_VISION_MODEL=qwen2.5vl:7b

# Option B: Gemini (Google AI Studio) — cloud free tier.
# https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_VISION_MODEL=gemini-3-flash

# ── USDA FoodData Central ─────────────────────────────
# https://fdc.nal.usda.gov/api-key-signup.html
USDA_FDC_API_KEY=
USDA_FDC_API_URL=https://api.nal.usda.gov/fdc/v1/foods/search

# ── Open Food Facts (no key needed) ───────────────────
# Optional alternate mirror/base
OFF_BASE_URL=https://world.openfoodfacts.org

# ── Storage (local demo profile) ──────────────────────
NEXT_PUBLIC_STORAGE_KEY=fodtrack-demo-v1
